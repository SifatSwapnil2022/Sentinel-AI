/// One row per day, with calendar attributes. Marked as the date table.
table dim_date
	lineageTag: 4b0ad022-d375-589d-b662-ead4b9a026ed
	dataCategory: Time

	column date
		dataType: dateTime
		formatString: yyyy-mm-dd
		isKey
		lineageTag: 6a83b47f-7e9f-55be-9e64-62d78c25d2f5
		summarizeBy: none
		sourceColumn: date
		annotation UnderlyingDateTimeDataType = Date

	column year
		dataType: int64
		formatString: 0
		lineageTag: 4af28821-3b05-5801-a32f-798c194d85cc
		summarizeBy: none
		sourceColumn: year

	column month
		dataType: int64
		formatString: 0
		lineageTag: d73d64e7-3d4e-5ea3-a360-b120ca3c6218
		summarizeBy: none
		sourceColumn: month

	column month_name
		dataType: string
		lineageTag: 7b5f9355-adf1-5a66-8523-3dd43cdb548c
		summarizeBy: none
		sourceColumn: month_name

	column iso_year
		dataType: int64
		formatString: 0
		lineageTag: bb9b9d4f-9daa-5760-9d03-2613b7cff6c6
		summarizeBy: none
		sourceColumn: iso_year

	column iso_week
		dataType: int64
		formatString: 0
		lineageTag: f0198aed-2864-5cb4-9244-9e33d3e80331
		summarizeBy: none
		sourceColumn: iso_week

	column weekday
		dataType: int64
		formatString: 0
		lineageTag: cda6156b-3cfe-50a7-a6f5-5e0f2f559dd5
		summarizeBy: none
		sourceColumn: weekday

	column weekday_name
		dataType: string
		lineageTag: 0059f79b-24d0-58a9-bbc5-e8488da58d73
		summarizeBy: none
		sourceColumn: weekday_name

	partition dim_date = m
		mode: import
		source =
				let
				    Source = Csv.Document(Web.Contents(DataUrl, [RelativePath = "dim_date.csv", Headers = if ApiKey = "" then [] else [Authorization = "Bearer " & ApiKey]]), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
				    Typed = Table.TransformColumnTypes(Promoted, {{"date", type date}, {"year", Int64.Type}, {"month", Int64.Type}, {"month_name", type text}, {"iso_year", Int64.Type}, {"iso_week", Int64.Type}, {"weekday", Int64.Type}, {"weekday_name", type text}}, "en-US")
				in
				    Typed
