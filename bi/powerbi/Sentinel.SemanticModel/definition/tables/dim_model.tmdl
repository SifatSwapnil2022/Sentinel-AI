/// One row per model: owner, version, label delay, reference metrics and current status.
table dim_model
	lineageTag: acd9eb88-7a68-5e9f-8a08-fe5843e8bccf

	column model_id
		dataType: string
		lineageTag: 772c77d2-f5df-53e0-9a86-406cc46864e7
		summarizeBy: none
		sourceColumn: model_id

	column model_name
		dataType: string
		lineageTag: 5c3806a9-d8ac-5bbc-9b3e-4268054a8254
		summarizeBy: none
		sourceColumn: model_name

	column team
		dataType: string
		lineageTag: f7a1b432-13ee-5cbf-b698-c2b0a11f06cb
