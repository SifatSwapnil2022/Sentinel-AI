		sourceColumn: version

	column description
		dataType: string
		lineageTag: 95545f57-1332-5511-bbef-c932a23f68c2
		summarizeBy: none
		sourceColumn: description

	column label_delay_days
		dataType: int64
		formatString: 0
		lineageTag: d68c16ff-ae4a-5064-96b6-fb0176cc6ad6
		summarizeBy: none
		sourceColumn: label_delay_days

	column reference_rows
		dataType: int64
		formatString: 0
		lineageTag: 50671cd9-fb7a-5869-86ea-5dc59683988f
		summarizeBy: none
		sourceColumn: reference_rows

	column reference_accuracy
		dataType: double
		formatString: 0.0%
		lineageTag: 603bc646-81c4-5cd5-8d21-d39d95b2a51b
		summarizeBy: none
		sourceColumn: reference_accuracy

	column reference_precision
		dataType: double
		formatString: 0.0%
		lineageTag: 16de3002-a1c9-5661-b33e-1fa78f249da9
		summarizeBy: none
		sourceColumn: reference_precision

	column reference_recall
		dataType: double
		formatString: 0.0%
		lineageTag: 7188b473-d7f1-5892-acd5-8907651bc68b
