	column open_incidents
		dataType: int64
		formatString: 0
		lineageTag: 1f395cc7-fd0c-5cbe-b1d9-b7c8743cd992
		summarizeBy: none
		sourceColumn: open_incidents

	partition dim_model = m
		mode: import
		source =
				let
				    Source = Csv.Document(Web.Contents(DataUrl, [RelativePath = "dim_model.csv", Headers = if ApiKey = "" then [] else [Authorization = "Bearer " & ApiKey]]), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
				    Typed = Table.TransformColumnTypes(Promoted, {{"model_id", type text}, {"model_name", type text}, {"team", type text}, {"version", type text}, {"description", type text}, {"label_delay_days", Int64.Type}, {"reference_rows", Int64.Type}, {"reference_accuracy", type number}, {"reference_precision", type number}, {"reference_recall", type number}, {"reference_f1", type number}, {"status", type text}, {"open_incidents", Int64.Type}}, "en-US")
				in
				    Typed
